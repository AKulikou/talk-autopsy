# Normalize line endings: LF in the repository, native on checkout
* text=auto

# Always LF (tooling and shell scripts expect it)
*.py text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Windows launcher: cmd needs CRLF; Windows PowerShell 5.1 needs the .ps1 BOM kept
*.bat text eol=crlf
*.ps1 text eol=crlf
