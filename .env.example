# Claude API key (https://console.anthropic.com/). Needed only by the Claude stages
# (correction, translation); cutting audio and speech recognition run without it.
ANTHROPIC_API_KEY=

# Target language of the translation and subtitles (ISO 639-1 code). Only ru is
# measured and accepted so far; the code takes any language.
TARGET_LANG=ru

# Model overrides. Empty = the default in talk_autopsy/config.py.
# Correction of the raw transcript (terms, names, accent-distorted words).
CORRECTION_MODEL=
# Translation of the corrected transcript, block by block.
TRANSLATION_MODEL=
# Small helper calls (glossary drafts, checks).
HELPER_MODEL=

# AssemblyAI key (https://www.assemblyai.com/dashboard). Optional: needed only by
# the AssemblyAI speech recognition engine (transcribe --engine assemblyai).
ASSEMBLYAI_API_KEY=

# Gemini API key (https://aistudio.google.com/apikey). Optional: needed only by
# the Gemini speech recognition engine (transcribe --engine gemini).
GEMINI_API_KEY=
# Gemini model overrides and billing tier. Empty = the defaults in
# talk_autopsy/config.py (the most capable free-tier model, a Flash fallback on a
# quota rejection, tier free = cost recorded as 0 with tokens kept).
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_TIER=

# Credentials the SDKs would pick up from the environment on their own. Leave them
# empty: this project passes its keys explicitly. Listed so that tests replace
# them with placeholders (config.SECRET_ENV_VARS) and nothing real leaks in.
# Bearer token read by the anthropic SDK; ANTHROPIC_API_KEY is what this project uses.
ANTHROPIC_AUTH_TOKEN=
# Google key read by the google-genai SDK; the explicit GEMINI_API_KEY takes precedence.
GOOGLE_API_KEY=
# Hugging Face token (https://huggingface.co/settings/tokens). Optional: used by
# faster-whisper's model download (higher rate limits); the models are public.
HF_TOKEN=
